# VideoShorts / Hyperion — local secrets (DO NOT COMMIT)
# Copy to videoshorts.local.env and fill in values.

# Covers Kie (GPT Image 2)
KIE_API_KEY=

# Dzen channel
DZEN_CHANNEL_NAME=
DZEN_CHANNEL_URL=

# Optional Yandex login (usually enough: «Войти в Дзен» in Results UI → cookies)
# DZEN_LOGIN=
# DZEN_PASSWORD=

# Капчу «Я не робот» не обходим: при появлении скрипт ждёт ручной клик
DZEN_CAPTCHA_WAIT_SEC=300

# Humanize публикации (паузы / hover / печать). HUMANIZE=0 — выключить везде.
HUMANIZE=1
# VK_HUMANIZE=1
# DZEN_HUMANIZE=1
# TIKTOK_HUMANIZE=1
# RUTUBE_HUMANIZE=1
# INSTAGRAM_HUMANIZE=1

# Instagram Reels (cookies → secrets/instagram_storage_state.json, not in git)
# VIDEOSHORTS_INSTAGRAM_STORAGE=videoshorts-memory/secrets/instagram_storage_state.json
# INSTAGRAM_TZ=Europe/Moscow
# INSTAGRAM_LOCALE=ru-RU
# INSTAGRAM_ASPECT=9:16

# Playwright window: user display #1 = rightmost, #2 = primary/main, #3 = top
PLAYWRIGHT_MONITOR=1
PLAYWRIGHT_MONITOR_LAYOUT=1:right,2:primary,3:top
