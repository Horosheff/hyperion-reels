# Copy this file to videoshorts.local.env and put your real key there.
# The local file is ignored by Git and must never be added to a brief,
# handoff, report, prompt, or support ticket.
KIE_API_KEY=replace_with_your_kie_api_key

# Playwright window placement (Hyperion):
# user #1 = rightmost, #2 = primary/main, #3 = top
PLAYWRIGHT_MONITOR=1
PLAYWRIGHT_MONITOR_LAYOUT=1:right,2:primary,3:top
